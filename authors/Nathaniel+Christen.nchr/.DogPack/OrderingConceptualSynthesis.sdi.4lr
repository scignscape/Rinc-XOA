sdi-sentence--end-pos 4#/4 399 71876 1341 16 ;.
sdi-sentence-end-punctuation $ . ;.
$.#406
|  By analogy,
|  human and computer vision share capabilities
|  whose functional roles in larger processing modules
.  can be analyzed
sdi-sentence-text $# 406 ;.

sdi-new-sentence 4# 400 ;.
sdi-sentence-switch-pos 4#/4 400 71877 1341 17 ;.
