sdi-sentence-switch-pos 4#/4 368 65503 1226 31 ;.
sdi-sentence--end-pos 4#/4 368 65703 1229 77 ;.
sdi-sentence-end-punctuation $ . ;.
$.#375
|  Because every
|  variable is initialized before use, we can assume that
|  any value is ultimately obtained from source code
.  as in item , or read from an external source (like a local file)
sdi-sentence-text $# 375 ;.

sdi-new-sentence 4# 369 ;.
sdi-sentence-switch-pos 4#/4 369 65704 1229 78 ;.
sdi-sentence--end-pos 4#/4 369 65754 1230 50 ;.
sdi-sentence-end-punctuation $ . ;.
