sdi-sentence-insert-outer-pos 2#/2 0 18 ;.
$.#298
|  <!!Bolt et. al.!!> generalize this kind of insight by proposing
|  Categories (in the mathematical sense) for syntax and semantics,
|  with lexical word-meanings serving as maps (technically
.  functors) from one to the other
sdi-sentence-text $# 298 ;.

sdi-new-sentence 4# 298 ;.
sdi-sentence-switch-pos 4#/4 298 53818 989 37 ;.
sdi-sentence--end-pos 4#/4 298 54101 994 8 ;.
sdi-sentence-end-punctuation $ . ;.
$.#299
|  Because functors
|  project morphisms (transforms in Categories) from one Category
|  to another, assemblies of syntactic operations
|  project onto semantic/conceptual structures systematically,
|  extending the lexicon-to-concept functor to aggregate
.  phrases
sdi-sentence-text $# 299 ;.

sdi-new-sentence 4# 299 ;.
sdi-sentence-switch-pos 4#/4 299 54102 994 9 ;.
sdi-sentence--end-pos 4#/4 299 54297 997 22 ;.
sdi-sentence-end-punctuation $ . ;.
$.#300
