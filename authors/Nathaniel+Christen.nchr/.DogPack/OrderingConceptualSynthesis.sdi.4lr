sdi-new-sentence 4# 370 ;.
sdi-sentence-switch-pos 4#/4 370 65760 1232 4 ;.
sdi-sentence--end-pos 4#/4 370 65854 1233 39 ;.
sdi-sentence-end-punctuation $ . ;.
