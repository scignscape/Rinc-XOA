sdi-sentence--end-pos 4#/4 366 65418 1223 25 ;.
sdi-sentence-end-punctuation $ . ;.
$.#373
|  Place the current
.  value on a program stack
sdi-sentence-text $# 373 ;.

sdi-new-sentence 4# 367 ;.
sdi-sentence-switch-pos 4#/4 367 65424 1225 4 ;.
sdi-sentence--end-pos 4#/4 367 65502 1226 30 ;.
sdi-sentence-end-punctuation $ . ;.
