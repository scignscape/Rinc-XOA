asl-sentence--end-pos 4#/4 402 72518 1351 49 ;.
asl-sentence-end-punctuation $ . ;.
$.#409
|  Still,
|  I believe these analogies imply a precis of the
|  syntax/semantics interface that is more cognitively realistic
.  than 's appeal to commutative diagrams
asl-sentence-text $# 409 ;.

asl-new-sentence 4# 403 ;.
asl-sentence-switch-pos 4#/4 403 72519 1351 50 ;.
asl-sentence--end-pos 4#/4 403 72624 1353 44 ;.
asl-sentence-end-punctuation $ . ;.
$.#410
|  Compilers
|  are stateful processing/workflow platforms,
.  more than mechanistic term-reduce artefacts
asl-sentence-text $# 410 ;.
