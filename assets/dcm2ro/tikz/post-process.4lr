.; Test as many opmethods as possible ;.

=prog

asa-load-svg-file $ /home/nlevisrael/gits/pnp-dev/rinc-xoa/RedPatch/dev/dcm2ro/tikz/i-from-pdf.svg ;.

asa-new->graphic-element ;.
 :interpretation $ nodule|unblinded-read ;.
 :characteristic $ subtlety ;.
 :value-u1 1# 3 ;. 

 .; 1 = Soft Tissue
    2 = Fluid
    3 = Fat
    4 = Air 
 ;.
 :characteristic $ internalStructure ;.
 :value-str $ soft-tissue ;. 
 :characteristic $ calcification ;.
 :value-u1 1# 6 ;. 
 :characteristic $ sphericity ;.
 :value-u1 1# 5 ;. 
 :characteristic $ margin ;.
 :value-u1 1# 5 ;. 
 :characteristic $ lobulation ;.
 :value-u1 1# 5 ;. 
 :characteristic $ spiculation ;.
 :value-u1 1# 5 ;. 
 :characteristic $ texture ;.
 :value-u1 1# 5 ;. 
 :characteristic $ malignancy ;.
 :value-u1 1# 5 ;. 

asa-path-id 2# 1 ;.
asa-path-id-string-auto $ em-path ;.

asa-path-group-id 2## 2 3 ;.
asa-path-group-glyphs $$ glyph0-1 ;.
asa-path-group-id-string-auto $ em-group ;.

asa-gel-id-string-auto $ gel ;.

asa-finalize<-graphic-element ;.


asa-new->graphic-element ;.

asa-path-id 2# 4 ;.
asa-path-id-string-auto $ em-path ;.

asa-path-group-id 2## 5 6 ;.
asa-path-group-glyphs $$ glyph1-1 ;.
asa-path-group-id-string-auto $ em-group ;.

asa-gel-id-string-auto $ gel ;.

asa-finalize<-graphic-element ;.


asa-prepare-svg-file ;.

asa-save-svg-file $ /home/nlevisrael/gits/pnp-dev/rinc-xoa/RedPatch/dev/dcm2ro/tikz/html/ia.svg ;.

asa-load-html-template $ /home/nlevisrael/gits/pnp-dev/rinc-xoa/RedPatch/dev/dcm2ro/tikz/template.html ;.
asa-prepare-html-file ;.

asa-save-html-file $ /home/nlevisrael/gits/pnp-dev/rinc-xoa/RedPatch/dev/dcm2ro/tikz/html/ia.html ;.

=done

